# Copy this file to ".env" and fill in your real keys.
# Or just export them in your shell before running.

# Used by the DeepEval judge LLM (GPT-4o)
OPENAI_API_KEY=sk-your-key-here or ollama
OPENAI_BASE_URL=http://localhost:11434/v1

CONFIDENT_API_KEY=

# Used by the agent itself (Claude) if you want to run the agent with a Claude model
ANTHROPIC_API_KEY=sk-ant-your-key-here

# DeepEval per-metric timeout overrides (local Ollama judges are slow); read by eval_bootstrap.py
DEEPEVAL_PER_TASK_TIMEOUT_SECONDS_OVERRIDE=900
DEEPEVAL_PER_ATTEMPT_TIMEOUT_SECONDS_OVERRIDE=300
